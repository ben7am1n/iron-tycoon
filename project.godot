; Godot 4.7.1 Project Configuration
; Gym Manager — cozy gym management sim

config_version=5

[application]

config/name="GymManager"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://src/main.tscn"

[display]

; Playable build window: 1280x720 matches the UI layer's default viewport
; (SelectionToolbar/HUD use 1280x720 as the presentation viewport).
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method.mobile="forward_plus"
; Pixel-art 2D: default texture import filter = Nearest (0), mipmaps off (0)
; (art-bible §8 — 2D 像素锐利靠导入设置的 Nearest 保证；4.7 最近邻视口缩放仅作用于 3D)
textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_texture_mipmap_mode=0

[input]

; Placeholder — input map will be configured during UI implementation
